# =============================================================================
# ANAK — variables de entorno (placeholders)
# Copiar a .env.local y completar cuando existan credenciales reales.
# Nunca commitear secretos. Los invites de grupos pagos NO van a NEXT_PUBLIC_.
# =============================================================================

# Sitio (SEO / canónico). Dominio se definirá después.
NEXT_PUBLIC_SITE_URL=

# Email transaccional / marketing (Resend) — stub, no implementar aún
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Pagos (Mercado Pago) — stub, no implementar checkout aún
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Base de datos (Supabase) — stub, no conectar aún
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth del panel admin — stub
ADMIN_PASSWORD=

# WhatsApp grupos pagos (Plus / VIP) — SOLO servidor, nunca exponer al cliente
WHATSAPP_PLUS_INVITE_URL=
WHATSAPP_VIP_INVITE_URL=

# CRM / reservas (Bewe u otro) — si aplica más adelante
BEWE_API_TOKEN=
BEWE_STUDIO_ID=
